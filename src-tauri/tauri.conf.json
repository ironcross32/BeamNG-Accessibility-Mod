{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "beamtel",
  "mainBinaryName": "beamtel",
  "identifier": "com.beam.accessibility",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BeamNG Accessibility",
        "width": 700,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
